        <mxCell id="interfaceplugins" value="&lt;b&gt;Interface Plugins&lt;/b&gt;&lt;br&gt;Official UI・第三方 UI&lt;br&gt;API Gateway（loopback 默认）" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#D97706;fillColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1345" y="870" width="250" height="120" as="geometry"/></mxCell>
