        <mxCell id="functional_zone" value="普通功能插件层（所有能力通过 Router 调用）" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeWidth=2;strokeColor=#8B5CF6;fillColor=#F5F3FF;align=left;verticalAlign=top;spacingTop=10;spacingLeft=10;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1085" width="1740" height="250" as="geometry"/></mxCell>
